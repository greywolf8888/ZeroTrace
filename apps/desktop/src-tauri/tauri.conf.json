{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroTrace 只读工作站",
  "version": "0.1.0",
  "identifier": "com.zerosdream.zerotrace",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare --prefix ../..",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/zerotrace-api"],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
