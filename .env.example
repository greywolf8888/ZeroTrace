# Runtime
NODE_ENV=development
HOST=0.0.0.0
API_PORT=8080
WEB_PORT=5173
POSTGRES_PORT=5432
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=8000
HEALTH_CACHE_TTL_MS=15000

# Provider security. Add only hosts you intentionally trust.
PROVIDER_ALLOW_HOSTS=eth-mainnet.g.alchemy.com,bnb-mainnet.g.alchemy.com,bsc-dataseed.bnbchain.org,bsc-dataseed-public.bnbchain.org,bsc.nodereal.io,bsc-mainnet.nodereal.io,rpc.ankr.com,bsc-rpc.publicnode.com,portal.sqd.dev,sourcify.dev,api.mainnet.solana.com,solana-rpc.publicnode.com,blockstream.info,lb.drpc.org,mainnet.helius-rpc.com
ALLOW_PRIVATE_PROVIDER_URLS=false

# Shared bounded-retry, rate-limit, cache, and circuit-breaker policy.
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_MS=100
PROVIDER_RETRY_MAX_MS=2000
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RESET_MS=30000
PROVIDER_CACHE_TTL_MS=1000
PROVIDER_CACHE_MAX_ENTRIES=500
# Matching endpoint observations required for anchor agreement. This does not establish operator independence.
DATA_QUALITY_MIN_SOURCES=2

# Ethereum: keep the key local. The URL template is ignored while the key is blank.
ALCHEMY_API_KEY=
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
EVM_ETHEREUM_RPC_URLS=
EVM_ETHEREUM_CHAIN_ID=1
EVM_ETHEREUM_SNAPSHOT_TAG=finalized
EVM_ETHEREUM_REQUESTS_PER_SECOND=5

# BNB Smart Chain: BNB Chain's public endpoint plus NodeReal's documented keyless endpoint
# provide a default cross-operator pair for read-only finalized anchor comparisons.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
EVM_BSC_RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc.nodereal.io
EVM_BSC_CHAIN_ID=56
EVM_BSC_SNAPSHOT_TAG=finalized
EVM_BSC_REQUESTS_PER_SECOND=10

# Optional free-registration slots. Blank = UNCONFIGURED. The API still starts.
# Cases that need archive/logs/trace stay PARTIAL/BLOCKED until the slot is configured and probed.
NODEREAL_API_KEY=
ANKR_API_KEY=
CHAINSTACK_BSC_RPC_URL=
DRPC_API_KEY=
HELIUS_API_KEY=

# Generic BSC trace slot. Do not hard-code a vendor into domain logic.
BSC_TRACE_RPC_URL=
BSC_TRACE_RPC_AUTH_TYPE=none
BSC_TRACE_RPC_SECRET=
BSC_TRACE_OPERATOR_ID=bsc-trace-slot

# Production auth. Leave blank in development; production refuses to boot APIs without both.
OIDC_ISSUER=
OIDC_AUDIENCE=
LOCAL_DEV_AUTH=0

# Bitcoin: Blockstream is a development fallback; self-host Esplora/Core for production.
BTC_ESPLORA_URL=https://blockstream.info/api
BITCOIN_ESPLORA_URLS=https://blockstream.info/api
BITCOIN_ESPLORA_REQUESTS_PER_SECOND=2

# Solana public RPC is rate-limited and intended only for development/fallback.
SOLANA_RPC_URL=https://api.mainnet.solana.com
SOLANA_RPC_URLS=
SOLANA_REQUESTS_PER_SECOND=4
SOLANA_COMMITMENT=finalized

# SQD is a clean remote HTTP boundary. The worker uses finalized-stream only; no SQD key is needed.
SQD_PORTAL_URL=https://portal.sqd.dev
SQD_PROVIDER_ALLOW_HOSTS=portal.sqd.dev
SQD_REQUESTS_PER_SECOND=2
SQD_MAX_RANGE_BLOCKS=50000

# Durable generic Action Semantics capture. Schedules reference already-ingested exact finalized
# transactions; the worker writes only Evidence, reports, and scheduler state to local storage.
CAPTURE_WORKER_OWNER=
CAPTURE_WORKER_POLL_INTERVAL_MS=5000
CAPTURE_WORKER_LEASE_SECONDS=300
CAPTURE_WORKER_BATCH_SIZE=10
CAPTURE_WORKER_REQUEST_TIMEOUT_MS=30000
# Optional: target one durable schedule during an operator replay; blank keeps normal queue order.
CAPTURE_WORKER_SCHEDULE_ID=
# Optional strict mode: every configured EVM RPC must agree for Token History exact reads.
# Keep false for ordinary failover; true requires at least two independently configured endpoints.
TOKEN_HISTORY_REQUIRE_INDEPENDENT_RPC=false
# Token History semantic ingestion advances this cursor after at most this many materialized
# event blocks. Lower values reduce replay work after interruption at the cost of more checkpoints.
TOKEN_HISTORY_CHECKPOINT_BATCH_SIZE=50
# Test/ops bound only; use --once interactively. Blank/false keeps the worker polling.
CAPTURE_WORKER_ONCE=false

# Durable reviewed EVM Claim Actions capture (BSC RPC + SQD, read-only).
CLAIM_CAPTURE_WORKER_OWNER=
CLAIM_CAPTURE_WORKER_POLL_INTERVAL_MS=5000
CLAIM_CAPTURE_WORKER_LEASE_SECONDS=300
CLAIM_CAPTURE_WORKER_BATCH_SIZE=10
CLAIM_CAPTURE_WORKER_ONCE=false

# Optional exact verified-source metadata. Sourcify V2 is read-only and requires no key.
SOURCIFY_V2_URL=https://sourcify.dev/server
SOURCIFY_REQUESTS_PER_SECOND=2

# Optional one-shot durable Flap origin worker inputs. Keep the token blank until explicitly used.
# The worker is read-only and resumes only an identical token/range/chunk identity.
FLAP_ORIGIN_TOKEN=
FLAP_ORIGIN_FROM_BLOCK=0
FLAP_ORIGIN_TO_BLOCK=0
FLAP_ORIGIN_CHUNK_SIZE=1000000

# Optional one-shot durable Flap event-history projection. Keep the token blank until explicitly used.
# Segments are persisted before cursor advancement; completed runs return a scan ID for replay.
FLAP_HISTORY_TOKEN=
FLAP_HISTORY_FROM_BLOCK=0
FLAP_HISTORY_TO_BLOCK=0
FLAP_HISTORY_SEGMENT_SIZE=50000
FLAP_HISTORY_CHUNK_SIZE=2000
FLAP_HISTORY_MAX_TRANSACTIONS=250
FLAP_HISTORY_MAX_LOGS=25000

# Optional durable BSC burn-candidate promotion. Keep the token blank until explicitly used.
# The worker checkpoints complete event segments, then certifies every candidate at its exact block.
BURN_PROMOTION_TOKEN=
BURN_PROMOTION_FROM_BLOCK=0
BURN_PROMOTION_TO_BLOCK=0
BURN_PROMOTION_SEGMENT_SIZE=1000000
BURN_PROMOTION_MAX_TRANSFERS=25000
BURN_PROMOTION_MAX_CANDIDATES_PER_SEGMENT=512

# Optional durable all-block ERC-20 totalSupply continuity. Keep the token blank until explicitly
# used. Each transition is pinned by block hash and cross-source exact equality; a verified result
# requires at least two officially registered operators. Two BNB Chain hostnames are one operator.
SUPPLY_CONTINUITY_TOKEN=
SUPPLY_CONTINUITY_FROM_BLOCK=1
SUPPLY_CONTINUITY_TO_BLOCK=1
SUPPLY_CONTINUITY_SEGMENT_SIZE=128
SUPPLY_CONTINUITY_MAX_TRANSFERS=25000

# Optional exact finalized Flap lifetime materialization. Keep the token blank until explicitly used.
# A blank target captures the current finalized BSC head; pin the emitted target block for exact reruns.
FLAP_LIFETIME_TOKEN=
FLAP_LIFETIME_TARGET_BLOCK=
# Optional: one finalized block independently verified as the token origin. This keeps lifetime coverage Unknown.
FLAP_LIFETIME_ORIGIN_HINT_BLOCK=
FLAP_LIFETIME_ORIGIN_CHUNK_SIZE=1000000
# Internal SQD creation-trace request window; increase only after the Portal accepts the response size.
SQD_CREATION_REQUEST_RANGE_BLOCKS=10000
FLAP_LIFETIME_HISTORY_SEGMENT_SIZE=5000
FLAP_LIFETIME_HISTORY_CHUNK_SIZE=2000
FLAP_LIFETIME_HISTORY_MAX_TRANSACTIONS=250
FLAP_LIFETIME_HISTORY_MAX_LOGS=25000

# Optional continuous finalized-head maintenance. This uses at least DATA_QUALITY_MIN_SOURCES
# distinct BSC RPC endpoints and appends only Evidence-proven lifetime deltas. Blank disables it.
FLAP_LIFETIME_HEAD_TOKEN=
FLAP_LIFETIME_HEAD_INTERVAL_MS=60000
# Test/ops bound only; blank means run until SIGINT/SIGTERM.
FLAP_LIFETIME_HEAD_MAX_CYCLES=

# Reserved optional integrations. Blank means explicitly unconfigured.
GMGN_API_KEY=
JUPITER_API_KEY=
ETHERSCAN_API_KEY=
DUNE_API_KEY=
NANSEN_API_KEY=
ARKHAM_API_KEY=

# Low-cost storage plane. Default stays on the developer machine; ClickHouse/MinIO/Archive remain optional.
ZEROTRACE_STORAGE_PROFILE=LOW_COST_CASE
ZEROTRACE_STORAGE_ROOT=data/storage-plane

# Tests write canonical fixtures. Set this only to a disposable initialized database.
TEST_POSTGRES_URL=
# Optional Apache AGE projection. For Compose graph profile, use the graph-db hostname shown in
# docs/DEVELOPMENT.md; for host-side development, use localhost and AGE_PORT instead.
AGE_URL=
TEST_AGE_URL=
# Durable historical ingestion backends.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
TEST_CLICKHOUSE_URL=
TEST_OBJECT_STORE_ENDPOINT=
TEST_OBJECT_STORE_ACCESS_KEY=
TEST_OBJECT_STORE_SECRET_KEY=
VALKEY_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=zerotrace
OBJECT_STORE_SECRET_KEY=change-me-in-non-local-environments
OBJECT_STORE_BUCKET=zerotrace-raw
