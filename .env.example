# Runtime
NODE_ENV=development
HOST=0.0.0.0
API_PORT=8080
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=8000
HEALTH_CACHE_TTL_MS=15000

# Provider security. Add only hosts you intentionally trust.
PROVIDER_ALLOW_HOSTS=eth-mainnet.g.alchemy.com,bsc-dataseed.bnbchain.org,bsc-dataseed-public.bnbchain.org,portal.sqd.dev,api.mainnet.solana.com,blockstream.info
ALLOW_PRIVATE_PROVIDER_URLS=false

# Shared bounded-retry, rate-limit, cache, and circuit-breaker policy.
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_MS=100
PROVIDER_RETRY_MAX_MS=2000
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RESET_MS=30000
PROVIDER_CACHE_TTL_MS=1000
PROVIDER_CACHE_MAX_ENTRIES=500
# Matching endpoint observations required for anchor agreement. This does not establish operator independence.
DATA_QUALITY_MIN_SOURCES=2

# Ethereum: keep the key local. The URL template is ignored while the key is blank.
ALCHEMY_API_KEY=
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
EVM_ETHEREUM_RPC_URLS=
EVM_ETHEREUM_CHAIN_ID=1
EVM_ETHEREUM_SNAPSHOT_TAG=finalized
EVM_ETHEREUM_REQUESTS_PER_SECOND=5

# BNB Smart Chain: public read-only endpoints; replace with dedicated endpoints for production.
BSC_RPC_URL=
EVM_BSC_RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed-public.bnbchain.org
EVM_BSC_CHAIN_ID=56
EVM_BSC_SNAPSHOT_TAG=finalized
EVM_BSC_REQUESTS_PER_SECOND=10

# Bitcoin: Blockstream is a development fallback; self-host Esplora/Core for production.
BTC_ESPLORA_URL=
BITCOIN_ESPLORA_URLS=https://blockstream.info/api
BITCOIN_ESPLORA_REQUESTS_PER_SECOND=2

# Solana public RPC is rate-limited and intended only for development/fallback.
SOLANA_RPC_URL=https://api.mainnet.solana.com
SOLANA_RPC_URLS=
SOLANA_REQUESTS_PER_SECOND=4
SOLANA_COMMITMENT=finalized

# SQD is a clean remote HTTP boundary. The worker uses finalized-stream only; no SQD key is needed.
SQD_PORTAL_URL=https://portal.sqd.dev
SQD_PROVIDER_ALLOW_HOSTS=portal.sqd.dev
SQD_REQUESTS_PER_SECOND=2
SQD_MAX_RANGE_BLOCKS=50000

# Optional one-shot durable Flap origin worker inputs. Keep the token blank until explicitly used.
# The worker is read-only and resumes only an identical token/range/chunk identity.
FLAP_ORIGIN_TOKEN=
FLAP_ORIGIN_FROM_BLOCK=0
FLAP_ORIGIN_TO_BLOCK=0
FLAP_ORIGIN_CHUNK_SIZE=1000000

# Reserved optional integrations. Blank means explicitly unconfigured.
GMGN_API_KEY=
JUPITER_API_KEY=
ETHERSCAN_API_KEY=
DUNE_API_KEY=
NANSEN_API_KEY=
ARKHAM_API_KEY=

# Local infrastructure. Docker Compose injects its own PostgreSQL URL automatically. For host-side
# `npm run dev`, leave POSTGRES_URL blank for explicit process-local Evidence or set it after starting
# `docker compose up -d postgres` to require durable Evidence/Snapshot persistence.
POSTGRES_URL=
# Tests write canonical fixtures. Set this only to a disposable initialized database.
TEST_POSTGRES_URL=
# Durable historical ingestion backends.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
TEST_CLICKHOUSE_URL=
TEST_OBJECT_STORE_ENDPOINT=
TEST_OBJECT_STORE_ACCESS_KEY=
TEST_OBJECT_STORE_SECRET_KEY=
VALKEY_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=zerotrace
OBJECT_STORE_SECRET_KEY=change-me-in-non-local-environments
OBJECT_STORE_BUCKET=zerotrace-raw
