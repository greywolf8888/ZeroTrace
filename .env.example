# Runtime
NODE_ENV=development
HOST=0.0.0.0
API_PORT=8080
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=8000
HEALTH_CACHE_TTL_MS=15000

# Provider security. Add only hosts you intentionally trust.
PROVIDER_ALLOW_HOSTS=api.mainnet.solana.com,blockstream.info
ALLOW_PRIVATE_PROVIDER_URLS=false

# EVM: configure one or more read-only JSON-RPC endpoints.
EVM_ETHEREUM_RPC_URL=
EVM_ETHEREUM_CHAIN_ID=1
EVM_BSC_RPC_URL=
EVM_BSC_CHAIN_ID=56

# Bitcoin: Blockstream is a development fallback; self-host Esplora/Core for production.
BITCOIN_ESPLORA_URL=https://blockstream.info/api

# Solana public RPC is rate-limited and intended only for development/fallback.
SOLANA_RPC_URL=https://api.mainnet.solana.com
SOLANA_COMMITMENT=finalized

# Reserved optional integrations. SQD/Jupiter and GMGN network calls are not wired yet;
# absence must not break the core application.
SQD_EVM_PORTAL_URL=
SQD_SOLANA_PORTAL_URL=
GMGN_API_KEY=
JUPITER_API_URL=

# Local infrastructure (Docker Compose defaults). Only POSTGRES_URL is currently parsed by
# the API, and durable repositories are not wired yet; the remaining services are topology-ready.
POSTGRES_URL=postgresql://zerotrace:zerotrace@localhost:5432/zerotrace
CLICKHOUSE_URL=http://localhost:8123
VALKEY_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=zerotrace
OBJECT_STORE_SECRET_KEY=change-me-in-non-local-environments
