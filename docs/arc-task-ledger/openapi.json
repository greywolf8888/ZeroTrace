    "/v1/registry": {
      "get": {
        "operationId": "getRegistry",
        "responses": {
          "200": {
            "description": "结构化结果；覆盖与资金状态另行表达",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registry"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{chainId}/{adapter}/{jobId}/evidence-requests": {
      "post": {
        "operationId": "requestBoundedEvidence",
        "description": "仅登记部署的已采集任务；每IP每小时6次，每任务每小时1个新申请，全局20个当前版本待办，最大200000区块，单轮2000；相同快照幂等。空请求，不接受URL/区间/私密说明。",
        "parameters": [
          {
            "name": "chainId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "adapter",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "结构化结果；覆盖与资金状态另行表达",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrichmentAccepted"
                }
              }
            }
          },
          "429": {
            "description": "结构化结果；覆盖与资金状态另行表达",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "结构化结果；覆盖与资金状态另行表达",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/live": {
      "get": {
        "operationId": "liveChainObservation",
        "summary": "单来源实时最终区块观察与最新持久快照提示",
        "description": "仅使用已登记来源；全局并发合并，成功或失败后冷却30秒。原始观察未归档，formalForensicReady=false；不执行任务扫描、转账或补证。来源陈旧、冲突、不可用与provider-down分开返回。",
        "responses": {
          "200": {
            "description": "typed chain state, observation or null, lastSuccessfulObservation, raw evidence, latestStored snapshot identity"
          }
        }
      }
    },
    "/v1/dashboard": {
      "get": {
        "operationId": "fixedSnapshotDashboard",
        "summary": "沿用原数据库的固定快照事实总览",
        "parameters": [
          {
            "name": "snapshotRunId",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ],
        "description": "最多读取按任务编号排序的前100项，truncated显式表示截断。报酬不是到账；状态分类不是资金金额。每项保留证据标识、来源、快照和coverage；不建立新数据权威。",
        "responses": {
          "200": {
            "description": "fixed snapshot, existing ruleVersion, coverage and public job rows"
          },
          "410": {
            "description": "快照不存在或过期"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Knowledge": {
        "oneOf": [
          {
            "type": "object",
            "required": ["state", "value", "evidenceIds"],
            "properties": {
              "state": {
                "const": "known"
              },
              "value": {},
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "derivation": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": ["state", "reason"],
            "properties": {
              "state": {
                "enum": ["unknown", "unavailable", "conflict", "unsupported"]
              },
              "reason": {
                "type": "string"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "Amount": {
        "type": "object",
        "required": ["asset", "decimals", "atomic"],
        "properties": {
          "asset": {
            "const": "USDC"
          },
          "decimals": {
            "const": 18
          },
          "atomic": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": ["chainId", "blockNumber", "blockHash", "observedAt", "finality"],
        "properties": {
          "chainId": {
            "const": "5042"
          },
          "blockNumber": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "blockHash": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{64}$"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finality": {
            "$ref": "#/components/schemas/Knowledge"
          }
        }
      },
      "Coverage": {
        "type": "object",
        "required": [
          "currentState",
          "jobEnumeration",
          "lifecycleHistory",
          "settlementHistory",
          "accountPendingHistory",
          "deploymentVerification",
          "sourceAgreement"
        ],
        "properties": {
          "currentState": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "jobEnumeration": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "lifecycleHistory": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "settlementHistory": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "accountPendingHistory": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "deploymentVerification": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "sourceAgreement": {
            "$ref": "#/components/schemas/Knowledge"
          }
        }
      },
      "JobRow": {
        "type": "object",
        "required": [
          "jobKey",
          "jobId",
          "adapter",
          "snapshot",
          "reward",
          "lifecycle",
          "cashState",
          "coverage"
        ],
        "properties": {
          "jobKey": {
            "type": "string"
          },
          "jobId": {
            "type": "string"
          },
          "adapter": {
            "type": "string"
          },
          "poster": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "worker": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          },
          "reward": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "lifecycle": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "cashState": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "historyRange": {
            "$ref": "#/components/schemas/HistoryRange"
          }
        }
      },
      "JobsPage": {
        "type": "object",
        "required": ["snapshotRunId", "items", "nextCursor", "coverage"],
        "properties": {
          "snapshotRunId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobRow"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          }
        }
      },
      "SettlementLeg": {
        "type": "object",
        "required": [
          "id",
          "role",
          "kind",
          "payee",
          "observedAmount",
          "parkedAmount",
          "attribution",
          "evidenceIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": ["WORKER", "POSTER", "PROTOCOL", "ESCROW", "ADAPTER"]
          },
          "kind": {
            "enum": [
              "REWARD",
              "FEE",
              "REFUND",
              "BOND_RETURN",
              "BOND_DEPOSIT",
              "BOND_FORFEIT",
              "TIMEOUT_SHARE",
              "ESCROW_TRANSIT",
              "DEPOSIT"
            ]
          },
          "payee": {
            "type": "string"
          },
          "observedAmount": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "parkedAmount": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "attribution": {
            "enum": [
              "DIRECT",
              "UNIQUE_EVENT_SEGMENT",
              "ACCOUNT_ONLY",
              "VERIFIED_SEQUENCE_DERIVED",
              "AMBIGUOUS",
              "ZERO_ALLOCATION",
              "UNKNOWN"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TimelineEvent": {
        "type": "object",
        "required": ["id", "name", "transactionHash", "logIndex", "blockNumber", "evidenceIds"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "transactionHash": {
            "type": "string"
          },
          "logIndex": {
            "type": "string"
          },
          "blockNumber": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "JobDetail": {
        "type": "object",
        "required": [
          "job",
          "rawState",
          "settlementLegs",
          "timeline",
          "nextTimelineCursor",
          "evidence",
          "ruleVersion",
          "result"
        ],
        "properties": {
          "job": {
            "$ref": "#/components/schemas/JobRow"
          },
          "rawState": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "settlementLegs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SettlementLeg"
            }
          },
          "timeline": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/TimelineEvent"
            }
          },
          "nextTimelineCursor": {
            "type": ["string", "null"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "payloadHash", "sourceAlias", "snapshot"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "payloadHash": {
                  "type": "string"
                },
                "sourceAlias": {
                  "type": "string"
                },
                "snapshot": {
                  "$ref": "#/components/schemas/Snapshot"
                },
                "safePayload": {}
              }
            }
          },
          "ruleVersion": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/SettlementResult"
          },
          "evidenceRequest": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/EvidenceRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshotTasks": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/JobRow"
            }
          }
        }
      },
      "CoverageStatus": {
        "type": "object",
        "required": [
          "network",
          "adapter",
          "lastSuccessfulSync",
          "stateHead",
          "historyHead",
          "coverage"
        ],
        "properties": {
          "network": {
            "const": "arc-mainnet"
          },
          "adapter": {
            "type": "string"
          },
          "lastSuccessfulSync": {
            "type": ["string", "null"]
          },
          "stateHead": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "historyHead": {
            "$ref": "#/components/schemas/Knowledge"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "enum": ["up", "down", "degraded"]
          },
          "components": {
            "type": "object"
          }
        }
      },
      "HistoryRange": {
        "type": "object",
        "description": "声明窗口连续水位；不等于部署全历史覆盖。",
        "required": [
          "scope",
          "fromBlock",
          "targetBlock",
          "contiguousThrough",
          "status",
          "omittedPriorHistory",
          "gaps"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "enum": ["DECLARED_WINDOW", "DEPLOYMENT_TO_SNAPSHOT"]
          },
          "fromBlock": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "targetBlock": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "contiguousThrough": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "status": {
            "enum": ["complete", "partial"]
          },
          "omittedPriorHistory": {
            "type": "boolean"
          },
          "checkpointKey": {
            "type": "string"
          },
          "checkpointVersion": {
            "type": "string"
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fromBlock": {
                  "type": "string"
                },
                "toBlock": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ResultMetric": {
        "type": "object",
        "required": [
          "key",
          "label",
          "amount",
          "scope",
          "evidenceIds",
          "qualifier",
          "role",
          "phase"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/ResultAmount"
          },
          "scope": {
            "enum": ["OBSERVED", "VERIFIED_OBLIGATIONS", "FACE_VALUE"]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "qualifier": {
            "enum": ["EXACT", "OBSERVED_SUBSET", "AT_LEAST", "UNKNOWN"]
          },
          "role": {
            "enum": ["WORKER", "POSTER", "PROTOCOL", "ADAPTER", "ESCROW", "TASK"]
          },
          "phase": {
            "enum": ["DIRECT", "CLAIMED", "OUTSTANDING", "FACE_VALUE"]
          }
        }
      },
      "SettlementResult": {
        "type": "object",
        "required": [
          "schemaVersion",
          "jobId",
          "state",
          "conclusion",
          "reasons",
          "nextAction",
          "metrics",
          "historyComplete",
          "gas",
          "flows"
        ],
        "properties": {
          "schemaVersion": {
            "const": "atl-settlement-result-v2"
          },
          "jobId": {
            "type": "string"
          },
          "state": {
            "enum": ["confirmed", "pending", "unknown", "conflict"]
          },
          "conclusion": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nextAction": {
            "type": "string"
          },
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResultMetric"
            }
          },
          "historyComplete": {
            "type": "boolean"
          },
          "gas": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["transactionHash", "amount", "payer", "scope", "evidenceIds"],
              "properties": {
                "transactionHash": {
                  "type": "string"
                },
                "amount": {
                  "$ref": "#/components/schemas/ResultAmount"
                },
                "payer": {
                  "$ref": "#/components/schemas/Knowledge"
                },
                "scope": {
                  "const": "TRANSACTION_ONLY"
                },
                "evidenceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "flows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SettlementFlow"
            }
          }
        }
      },
      "EvidenceRequest": {
        "type": "object",
        "required": ["id", "jobId", "from", "to", "head", "status", "ruleVersion", "snapshotRunId"],
        "properties": {
          "id": {
            "type": "string"
          },
          "jobId": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "head": {
            "type": "string"
          },
          "ruleVersion": {
            "type": "string"
          },
          "snapshotRunId": {
            "type": "string"
          },
          "status": {
            "enum": ["PENDING", "COMPLETED", "FAILED"]
          },
          "plan": {
            "type": "object",
            "required": [
              "version",
              "targetKinds",
              "basis",
              "reason",
              "priorCoverage",
              "beforeReceiptHashes",
              "beforeConclusion"
            ],
            "properties": {
              "version": {
                "const": "atl-enrichment-plan-v2"
              },
              "targetKinds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "basis": {
                "enum": ["KNOWN_EVENT", "KNOWN_CREATION_UNSCANNED", "UNLOCATABLE", "COVERED"]
              },
              "reason": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "priorCoverage": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["from", "to"],
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    }
                  }
                }
              },
              "beforeReceiptHashes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "beforeConclusion": {
                "type": "string"
              }
            }
          },
          "outcome": {
            "type": "object",
            "required": ["state", "beforeSnapshot", "newEvidenceIds", "conclusionChanged"],
            "properties": {
              "state": {
                "enum": [
                  "PENDING",
                  "NEW_EVIDENCE_FOUND",
                  "NO_MATCH_IN_RANGE",
                  "STILL_INSUFFICIENT",
                  "FAILED"
                ]
              },
              "beforeSnapshot": {
                "type": "string"
              },
              "afterSnapshot": {
                "type": "string"
              },
              "newEvidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "conclusionChanged": {
                "type": ["boolean", "null"]
              }
            }
          }
        }
      },
      "Registry": {
        "type": "object",
        "required": ["chainId", "adapter", "navigation"],
        "properties": {
          "chainId": {
            "const": "5042"
          },
          "adapter": {
            "type": "string"
          },
          "navigation": {
            "type": "object"
          }
        }
      },
      "EnrichmentAccepted": {
        "type": "object",
        "required": ["request"],
        "properties": {
          "request": {
            "$ref": "#/components/schemas/EvidenceRequest"
          }
        }
      },
      "ResultAmount": {
        "type": "object",
        "required": ["asset", "decimals", "atomic"],
        "properties": {
          "asset": {
            "type": "string"
          },
          "decimals": {
            "type": "integer"
          },
          "atomic": {
            "$ref": "#/components/schemas/Knowledge"
          }
        }
      },
      "SettlementFlow": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "role",
          "kind",
          "phase",
          "amount",
          "evidenceIds",
          "eventIds",
          "transactionHashes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "role": {
            "enum": ["WORKER", "POSTER", "PROTOCOL", "ADAPTER", "ESCROW"]
          },
          "kind": {
            "type": "string"
          },
          "phase": {
            "enum": ["DIRECT", "PARKED", "CLAIMED"]
          },
          "amount": {
            "$ref": "#/components/schemas/ResultAmount"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "eventIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transactionHashes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
