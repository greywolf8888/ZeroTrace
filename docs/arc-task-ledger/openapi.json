{
  "openapi": "3.1.0",
  "info": {
    "title": "Arc 任务证据只读 API",
    "version": "1.3.0",
    "description": "持久快照查询与有界补证申请；链上只读，HTTP成功不代表证据完整。"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/v1/jobs": {
      "get": {
        "operationId": "listJobs",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "address",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$"
            }
          },
          {
            "name": "lifecycle",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 48
            }
          },
          {
            "name": "cashState",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 48
            }
          },
          {
            "name": "role",
            "in": "query",
            "schema": {
              "enum": ["all", "poster", "worker"]
            },
            "description": "必须同时提供完整地址；由数据库过滤"
          },
          {
            "name": "snapshotRunId",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "固定快照；过期返回410，不替换"
          }
        ],
        "responses": {
          "200": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsPage"
                }
              }
            }
          },
          "400": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{chainId}/{adapter}/{jobId}": {
      "get": {
        "operationId": "getJob",
        "parameters": [
          {
            "name": "chainId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["5042"]
            }
          },
          {
            "name": "adapter",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$"
            }
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,78}$"
            }
          },
          {
            "name": "snapshotRunId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "timelineCursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["json"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDetail"
                }
              }
            }
          },
          "400": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
