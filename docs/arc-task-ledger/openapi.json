                }
              }
            }
          },
          "503": {
            "description": "Read-only typed response; completeness is in coverage, not HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
