{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "paths": {
      "@zerotrace/schemas": ["./packages/schemas/src/index.ts"],
      "@zerotrace/identifiers": ["./packages/identifiers/src/index.ts"],
      "@zerotrace/evidence": ["./packages/evidence/src/index.ts"],
      "@zerotrace/data-quality": ["./packages/data-quality/src/index.ts"],
      "@zerotrace/storage": ["./packages/storage/src/index.ts"],
      "@zerotrace/ingestion": ["./packages/ingestion/src/index.ts"],
      "@zerotrace/chain-adapters": ["./packages/chain-adapters/src/index.ts"],
      "@zerotrace/platform-adapters": ["./packages/platform-adapters/src/index.ts"],
      "@zerotrace/action-semantics": ["./packages/action-semantics/src/index.ts"],
      "@zerotrace/capture-scheduler": ["./packages/capture-scheduler/src/index.ts"],
      "@zerotrace/entity-engine": ["./packages/entity-engine/src/index.ts"],
      "@zerotrace/claim-audit": ["./packages/claim-audit/src/index.ts"],
      "@zerotrace/rv": ["./packages/rv/src/index.ts"],
      "@zerotrace/token-flow-engine": ["./packages/token-flow-engine/src/index.ts"],
      "@zerotrace/cluster-position-engine": ["./packages/cluster-position-engine/src/index.ts"],
      "@zerotrace/candidate-discovery": ["./packages/candidate-discovery/src/index.ts"],
      "@zerotrace/behavior-engine": ["./packages/behavior-engine/src/index.ts"],
      "@zerotrace/campaign-engine": ["./packages/campaign-engine/src/index.ts"],
      "@zerotrace/forensic-evidence": ["./packages/forensic-evidence/src/index.ts"]
    }
  }
}
