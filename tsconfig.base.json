{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "paths": {
      "@zerotrace/schemas": ["./packages/schemas/src/index.ts"],
      "@zerotrace/identifiers": ["./packages/identifiers/src/index.ts"],
      "@zerotrace/evidence": ["./packages/evidence/src/index.ts"],
      "@zerotrace/storage": ["./packages/storage/src/index.ts"],
      "@zerotrace/chain-adapters": ["./packages/chain-adapters/src/index.ts"],
      "@zerotrace/platform-adapters": ["./packages/platform-adapters/src/index.ts"],
      "@zerotrace/entity-engine": ["./packages/entity-engine/src/index.ts"],
      "@zerotrace/rv": ["./packages/rv/src/index.ts"]
    }
  }
}
